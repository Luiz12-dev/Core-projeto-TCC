# Copie para .env e ajuste. O .env NAO deve ser versionado.
#
# Em desenvolvimento nada disso e obrigatorio: application.properties traz
# defaults que funcionam com o docker-compose deste repositorio. Em producao,
# defina todas as variaveis abaixo.

# Banco de dados
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Chave HS512 do JWT — precisa ter no minimo 64 caracteres e ser IDENTICA
# nos dois servicos (autenticacao e core). E o unico acoplamento entre eles:
# se divergirem, toda requisicao autenticada ao core falha silenciosamente.
JWT_SECRET_KEY=
